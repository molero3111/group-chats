apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: group-chats-ingress
spec:
  rules:
  - host: group-chats.emmanuelcodinghub.com
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: group-chats
            port:
              number: 8000
  tls:
  - hosts:
    - group-chats.emmanuelcodinghub.com
    secretName: tls-secret-name
