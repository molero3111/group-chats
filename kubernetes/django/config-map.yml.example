apiVersion: v1
kind: ConfigMap
metadata:
  name: group-chats-config
data:
  DEBUG: "False"
  ALLOWED_HOSTS: "group-chats.emmanuelcodinghub.com"
  CSRF_TRUSTED_ORIGINS: "https://group-chats.emmanuelcodinghub.com"
  DJANGO_SETTINGS_MODULE: "groupchats.settings"
  POSTGRES_HOST: "group-chats-db"
  POSTGRES_PORT: "5432"
  POSTGRES_DB: "group_chats"
  POSTGRES_USER: "postgres"
  REDIS_HOST: "group-chats-redis"
  REDIS_PORT: "6379"
  REDIS_APP_DB: "1"
  REDIS_DEFAULT_DB: "0"
  REDIS_DEFAULT_KEY_EXPIRATION: "3600"
