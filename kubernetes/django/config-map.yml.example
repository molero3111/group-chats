apiVersion: v1
kind: ConfigMap
metadata:
  name: chat-config
data:
  DEBUG: "True"
  ALLOWED_HOSTS: "localhost,127.0.0.1,[::1]"
  CSRF_TRUSTED_ORIGINS: "http://localhost:8000,http://127.0.0.1:8000"
  DJANGO_SETTINGS_MODULE: "djangochat.settings"
  POSTGRES_HOST: "chat-db"
  POSTGRES_PORT: "5432"
  POSTGRES_DB: "django_chat_db"
  POSTGRES_USER: "postgres"
  REDIS_HOST: "chat-redis"
  REDIS_PORT: "6379"
  REDIS_APP_DB: "1"
  REDIS_DEFAULT_DB: "0"
  REDIS_DEFAULT_KEY_EXPIRATION: "3600"
  URL_PREFIX: ""