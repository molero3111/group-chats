SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1 group-chats.emmanuelcodinghub.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000 http://127.0.0.1:8000 https://group-chats.emmanuelcodinghub.com
DJANGO_SETTINGS_MODULE=groupchats.settings
# Behind Cloudflare: trust its X-Forwarded-Proto, send cookies over https only, and read the
# client address from CF-Connecting-IP (CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP). Off for local http.
USE_X_FORWARDED_PROTO=False
SECURE_COOKIES=False
CLIENT_IP_HEADER=

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=group_chats
POSTGRES_USER=group_chats
POSTGRES_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_APP_DB=1
REDIS_DEFAULT_DB=0
REDIS_PASSWORD=change-me
REDIS_DEFAULT_KEY_EXPIRATION=3600

HOST_MACHINE_WEB_PORT=8000

# Realtime transport: channels (Django Channels over Redis) or columba (hosted fan-out).
CHAT_TRANSPORT=channels
# Columba app values come from the Columba dashboard; never commit them.
COLUMBA_URL=
COLUMBA_SOCKET_URL=
COLUMBA_APP_ID=
COLUMBA_API_KEY=
COLUMBA_SIGNING_SECRET=
