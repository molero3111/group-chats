events {
    worker_connections  65536;
}

http {
    server {
        listen 80;
        server_name localhost;  # Adjust accordingly if using a domain

        location /chat-app/ {
            proxy_pass http://web:8000/;  # Points to your Django web service
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /chat-app/ws/ {
            proxy_pass http://web:8000/;  # Points to your Django web service handling WebSocket connections
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
